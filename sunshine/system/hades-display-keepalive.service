[Unit]
Description=Keep the Sunshine dummy display awake for unattended streaming
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep --who=Sunshine-Host --why=Unattended-game-streaming /usr/bin/sleep infinity
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
