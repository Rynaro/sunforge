# Copy to host.env and customize. host.env is intentionally ignored by Git.
SUNSHINE_HOST_NAME=Gaming-PC

# Stable prefix from the output's KWin `edidIdentifier`. Leave empty to select
# the first enabled 3840x2160 output.
SUNSHINE_DISPLAY_EDID_PREFIX=

# Optional connector override used by legacy display helpers.
SUNSHINE_DISPLAY_CONNECTOR=HDMI-A-1

# Optional NIC override. Empty means the interface carrying the default route.
SUNSHINE_STREAM_NIC=
