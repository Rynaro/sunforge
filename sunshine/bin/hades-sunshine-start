#!/usr/bin/env bash
set -euo pipefail

# KWin chooses a fresh Xauthority path whenever its Wayland service restarts.
# Parse the compositor command line instead of baking an ephemeral path into the
# unit. Steam's updater still needs X11/Xauthority even when its UI uses Wayland.
kwin_args=""
for _ in {1..100}; do
  kwin_args="$(ps -C kwin_wayland -o args= 2>/dev/null | head -n1)"
  [[ "$kwin_args" == *--xwayland-xauthority* ]] && break
  sleep 0.1
done

if [[ "$kwin_args" =~ --socket[[:space:]]+([^[:space:]]+) ]]; then
  export WAYLAND_DISPLAY="${BASH_REMATCH[1]}"
else
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
fi

if [[ "$kwin_args" =~ --xwayland-display[[:space:]]+([^[:space:]]+) ]]; then
  export DISPLAY="${BASH_REMATCH[1]}"
fi

if [[ "$kwin_args" =~ --xwayland-xauthority[[:space:]]+([^[:space:]]+) ]]; then
  export XAUTHORITY="${BASH_REMATCH[1]}"
else
  echo "Unable to discover KWin Xauthority" >&2
  exit 1
fi

export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
exec /usr/bin/sunshine
